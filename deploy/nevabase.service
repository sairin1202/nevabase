[Unit]
Description=nevabase.com hub (homepage, sign-in, shared assets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/project/nevabase
Environment=PYTHONPATH=/home/ubuntu/project/nevabase/core:/home/ubuntu/project/nevabase
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/project/nevabase/.env
ExecStart=/home/ubuntu/project/nevabase/.venv/bin/uvicorn hub.app:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
