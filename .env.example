# Offline generation (gen.py) only: OpenAI-compatible relay. Empty LLM_API_KEY => no LLM proposals, no review summaries.
LLM_BASE_URL=https://nevatoken.com/v1
LLM_API_KEY=
LLM_MODEL=MaaS_Deepseek_V4_pro_20260813
# Firebase login: service-account JSON path (default secrets/firebase-service-account.json)
NEVA_FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
NEVA_ADMIN_TOKEN=
# Market services: seconds between data syncs; NEVA_SYNC=0 disables the loop
NEVA_SYNC_INTERVAL=3600
